# 依赖
node_modules/
__pycache__/
*.pyc
.venv/

# 抓取的 CF 混淆脚本样本（体积大且随请求变化，不入库）
main_*.js
orchestrate_chl_page.js
challenge_page.html
chl_opt.js

# 求解过程中产生的凭证与截图（含真实 cf_clearance，绝不入库）
cookie.txt
ua.txt
*_cookie.txt
challenge_screenshot.png

# 求解服务自动生成的鉴权 token（首启写入，绝不入库）
.env

# 运行日志（scripts/run-pool.ps1 会写这里）
/logs/

# 构建产物（go build 会在源码目录留下 exe）
*.exe

# Python / 测试
__pycache__/
.pytest_cache/

# 编辑器/系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
