# 依赖
node_modules/
__pycache__/
*.pyc
.venv/

# 抓取的 CF 混淆脚本样本（体积大且随请求变化，不入库）
# scripts/capture_sample.py 的默认输出目录（manifest.json 含目标站信息，也不入库）
/samples/
# 真机取证产物（含真实 cf_clearance / __cf_bm 值，绝不入库）
_cookie_dump.json
*_cookie_dump.json

main_*.js
orchestrate_chl_page.js
challenge_page.html
chl_opt.js

# 求解过程中产生的凭证与截图（含真实 cf_clearance，绝不入库）
cookie.txt
ua.txt
*_cookie.txt
challenge_screenshot.png

# 求解服务自动生成的鉴权 token（首启写入，绝不入库）
.env

# 运行日志（scripts/run-pool.ps1 会写这里）
/logs/

# 构建产物（go build 会在源码目录留下 exe）
*.exe

# Python / 测试
__pycache__/
.pytest_cache/

# 编辑器/系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# 覆盖率产物（会随测试生成）
.coverage
coverage.xml
coverage.json
htmlcov/

# codegraph 本地索引缓存（可重建：codegraph index）
.codegraph/

# 会话快照归档（T-66：CF 版权代码 + 体积 + 脱敏后仍有指纹价值，不入库；
# 入库的是 corpus/INDEX.json 元数据摘要）
corpus/

# 运行产物（T-69）：任何缓存库、盐、pid、日志都不属于仓库；
# plans/证据/ 只放不可再生的验收输出（见 plans/证据/README.md 三条硬规则）
plans/证据/**/cache/
plans/证据/**/*.sqlite3*
plans/证据/**/salt.bin
plans/证据/**/pid.txt
plans/证据/**/*.log
plans/证据/**/.env
# 会话快照语料（体积大，只入库 corpus/INDEX.json 元数据；T-66）
corpus/
