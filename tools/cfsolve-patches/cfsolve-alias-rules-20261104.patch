diff --git a/src/alias_rules.rs b/src/alias_rules.rs
new file mode 100644
index 0000000..69528ea
--- /dev/null
+++ b/src/alias_rules.rs
@@ -0,0 +1,414 @@
+//! Rules for computed keys that alias a static string.
+//!
+//! The 11-03 patch relaxed two hand-written checks — [`crate::deobfuscate`]'s
+//! `is_static_member_key` and the `Member` branch of
+//! [`crate::challenge::expression::evaluate`] — to read a computed key that is itself a static
+//! member read, `record[helper.key]`. Both checks now consult the same embedded rule table, so a
+//! new obfuscator shape is added once, as data, instead of twice, as code.
+//!
+//! The table is generated, not written: `tools/cfsolve-patches/analyze/alias_shapes.py` (in the
+//! CF-Bypass-Research checkout) normalizes every computed-key expression in a rule corpus to a
+//! *shape signature* — the expression with every variable name erased — and reports whether its
+//! evaluator resolved that shape without running code. A shape that resolved only sometimes
+//! stays dynamic, because the generator reports `static_evaluable` only when every instance
+//! resolved. Shapes the table does not name are dynamic.
+//!
+//! That default is what keeps the relaxation from overshooting. `record[getKey()]` has no rule,
+//! so it stays dynamic even if the alias table happens to hold a value under a key of that name,
+//! and the object it reads stays opaque instead of being rewritten on a guessed key.
+//!
+//! `CFSOLVE_ALIAS_RULES=off` restores the hard-coded checks, for bisecting a regression against
+//! the 11-03 path.
+
+use std::collections::BTreeMap;
+use std::sync::OnceLock;
+
+use anyhow::{Context, Result};
+use serde_json::Value;
+use swc_core::ecma::ast::{Expr, Lit, MemberProp};
+
+/// The generated rule table, embedded so the solver reads no file at runtime.
+///
+/// Regenerate it from the rule corpus, then copy it here:
+///
+/// ```text
+/// python tools/cfsolve-patches/analyze/alias_shapes.py \
+///     tools/cfsolve-patches/analyze/fixtures/alias-rules.js \
+///     --out /d/cfsolve-upstream/src/alias_rules.json
+/// ```
+///
+/// `--check` compares a generated table against this file and exits non-zero on drift.
+const GENERATED: &str = include_str!("alias_rules.json");
+
+/// The switch that restores the hard-coded checks.
+const SWITCH: &str = "CFSOLVE_ALIAS_RULES";
+
+/// Whether a computed key of this shape is an alias for a static string.
+pub(crate) fn is_alias_key(expression: &Expr) -> bool {
+    is_alias_key_with(expression, enabled())
+}
+
+/// Whether [`signature`] is admitted by the embedded table.
+#[cfg(test)]
+fn is_admitted(signature: &str) -> bool {
+    rules().is_static(signature)
+}
+
+/// Reads the switch once: the rules are either on or off for the life of the process.
+fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| switch(std::env::var(SWITCH).ok().as_deref()))
+}
+
+/// Whether the switch `value` leaves the rule table in charge. Only an explicit off value hands
+/// control back to the hard-coded checks, so an unset or unrelated value changes nothing.
+fn switch(value: Option<&str>) -> bool {
+    match value {
+        Some(value) => !matches!(
+            value.trim().to_ascii_lowercase().as_str(),
+            "off" | "0" | "false"
+        ),
+        None => true,
+    }
+}
+
+/// [`is_alias_key`] with the data-driven decision chosen by the caller, for tests and for the
+/// command-level switch.
+fn is_alias_key_with(expression: &Expr, data_driven: bool) -> bool {
+    if data_driven {
+        return rules().is_static(&signature(expression));
+    }
+    // The 11-03 check, unchanged: `record[helper.key]`, spelled with a plain `.key`.
+    match expression.unwrap_parens() {
+        Expr::Member(member) => {
+            member.obj.as_ident().is_some() && matches!(member.prop, MemberProp::Ident(_))
+        }
+        _ => false,
+    }
+}
+
+/// The rule table. A malformed embedded table parses as empty, which leaves every shape dynamic:
+/// the table can only admit keys the generator measured, never guessed ones.
+#[derive(Default)]
+struct Rules {
+    /// Whether every generated instance of a shape signature resolved without running code.
+    shapes: BTreeMap<String, bool>,
+}
+
+impl Rules {
+    fn parse(json: &str) -> Result<Self> {
+        let table: BTreeMap<String, Value> =
+            serde_json::from_str(json).context("reading the alias rule table")?;
+        let mut shapes = BTreeMap::new();
+        for (signature, entry) in table {
+            let static_evaluable = entry
+                .get("static_evaluable")
+                .and_then(Value::as_bool)
+                .with_context(|| format!("alias rule {signature} has no static_evaluable"))?;
+            shapes.insert(signature, static_evaluable);
+        }
+        Ok(Self { shapes })
+    }
+
+    /// Whether the shape is an alias key. Unnamed shapes are dynamic.
+    fn is_static(&self, signature: &str) -> bool {
+        self.shapes.get(signature).copied().unwrap_or(false)
+    }
+}
+
+/// The embedded table, parsed once.
+fn rules() -> &'static Rules {
+    static RULES: OnceLock<Rules> = OnceLock::new();
+    RULES.get_or_init(|| Rules::parse(GENERATED).unwrap_or_default())
+}
+
+/// The shape signature of a key expression: the expression with every variable name erased.
+///
+/// Mirrors `render` in `alias_shapes.py`. The two must agree, or a signature the table names
+/// will never match; [`tests`] pins the spellings this code produces.
+pub(crate) fn signature(expression: &Expr) -> String {
+    match expression.unwrap_parens() {
+        // `undefined` is a literal to the generator, and reads as one here: no rule can name it.
+        Expr::Ident(name) if &*name.sym == "undefined" => "LIT".to_owned(),
+        Expr::Ident(_) => "IDENT".to_owned(),
+        Expr::Lit(_) => "LIT".to_owned(),
+        Expr::Member(member) => format!(
+            "MEMBER({},{})",
+            signature(&member.obj),
+            property(&member.prop)
+        ),
+        Expr::Call(call) => {
+            let arguments: Vec<&str> = call
+                .args
+                .iter()
+                .map(|argument| {
+                    if argument.spread.is_none() && is_literal(&argument.expr) {
+                        "LIT"
+                    } else {
+                        "EXPR"
+                    }
+                })
+                .collect();
+            let callee = call
+                .callee
+                .as_expr()
+                .map_or_else(|| "EXPR".to_owned(), |callee| signature(callee));
+            format!("CALL({callee},[{}])", arguments.join(","))
+        }
+        Expr::Bin(binary) => format!("BINOP({})", binary.op.as_str()),
+        Expr::Unary(unary) => format!("UNARY({})", unary.op.as_str()),
+        Expr::Fn(_) | Expr::Arrow(_) => "FUNC(...)".to_owned(),
+        Expr::Array(array) => {
+            let literal = !array.elems.is_empty()
+                && array.elems.iter().all(|element| {
+                    element.as_ref().is_some_and(|element| {
+                        element.spread.is_none() && is_literal(&element.expr)
+                    })
+                });
+            if literal {
+                "ARRAY([LIT])".to_owned()
+            } else {
+                "ARRAY([...])".to_owned()
+            }
+        }
+        Expr::Object(_) => "OBJECT({...})".to_owned(),
+        _ => "EXPR".to_owned(),
+    }
+}
+
+/// A member's property as the generator spells it. A name and a string literal collapse to the
+/// same signature, because obfuscators write the same alias as `.key` and as `["key"]`.
+fn property(property: &MemberProp) -> String {
+    match property {
+        MemberProp::Ident(_) => "IDENT".to_owned(),
+        MemberProp::Computed(computed) => match computed.expr.unwrap_parens() {
+            Expr::Lit(Lit::Str(_)) => "IDENT".to_owned(),
+            expression => signature(expression),
+        },
+        MemberProp::PrivateName(_) => "EXPR".to_owned(),
+    }
+}
+
+/// Whether an expression is a literal to the generator: `render` gives these the `LIT` signature
+/// wherever they sit in a call argument or array element.
+fn is_literal(expression: &Expr) -> bool {
+    match expression.unwrap_parens() {
+        Expr::Lit(_) => true,
+        Expr::Ident(name) => &*name.sym == "undefined",
+        _ => false,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use swc_core::ecma::ast::Expr;
+
+    use super::{
+        GENERATED, Rules, SWITCH, enabled, is_admitted, is_alias_key, is_alias_key_with, signature,
+        switch,
+    };
+    use crate::js::ast;
+
+    fn key(source: &str) -> Expr {
+        ast::parse_expression("key", source).unwrap()
+    }
+
+    /// Every shape the table names, regenerated from the rule corpus, keeps its five fields.
+    #[test]
+    fn embedded_rules_carry_the_generated_fields() {
+        let table: std::collections::BTreeMap<String, serde_json::Value> =
+            serde_json::from_str(GENERATED).expect("the embedded table is JSON");
+        assert!(!table.is_empty(), "the embedded table admits no shape");
+        for (signature, entry) in &table {
+            for field in [
+                "count",
+                "static_evaluable",
+                "static_instances",
+                "dynamic_instances",
+                "examples",
+            ] {
+                assert!(
+                    entry.get(field).is_some(),
+                    "{signature} has no {field}: regenerate with alias_shapes.py"
+                );
+            }
+        }
+        // A table that will not parse leaves every shape dynamic, so it is worth failing loudly.
+        Rules::parse(GENERATED).expect("the embedded table parses");
+        assert!(
+            is_admitted("MEMBER(IDENT,IDENT)"),
+            "the alias shape is missing"
+        );
+    }
+
+    /// Renaming the variables of an expression does not change its signature, which is what
+    /// lets a rule written once apply to every build.
+    #[test]
+    fn signature_normalization_is_stable() {
+        for (left, right) in [
+            ("helper.key", "h.k"),
+            ("helper['key']", "hkey.name"),
+            ("getKey()", "other()"),
+            ("a + b", "first + second"),
+            ("helper[0]", "other[0]"),
+        ] {
+            assert_eq!(
+                signature(&key(left)),
+                signature(&key(right)),
+                "{left}/{right}"
+            );
+        }
+    }
+
+    /// The spellings this code produces for the shapes that matter. `alias_shapes.py` writes the
+    /// same strings for the same expressions; a change here breaks the table silently otherwise.
+    #[test]
+    fn signature_spellings_match_the_generator() {
+        for (source, expected) in [
+            ("helper.key", "MEMBER(IDENT,IDENT)"),
+            ("helper['key']", "MEMBER(IDENT,IDENT)"),
+            ("helper[0]", "MEMBER(IDENT,LIT)"),
+            ("helper[key]", "MEMBER(IDENT,IDENT)"),
+            ("getKey()", "CALL(IDENT,[])"),
+            ("helper.get()", "CALL(MEMBER(IDENT,IDENT),[])"),
+            ("a + b", "BINOP(+)"),
+            ("-a", "UNARY(-)"),
+            ("'name'", "LIT"),
+            ("undefined", "LIT"),
+            ("helper[`key`]", "MEMBER(IDENT,EXPR)"),
+            ("helper[key[0]]", "MEMBER(IDENT,MEMBER(IDENT,LIT))"),
+        ] {
+            assert_eq!(signature(&key(source)), expected, "{source}");
+        }
+    }
+
+    /// The regression pair the relaxation must keep apart: a member read resolves to a literal
+    /// key, a call can name any property.
+    #[test]
+    fn reverse_cases_keep_calls_dynamic() {
+        let static_keys = ["helper.key", "helper['key']"];
+        let dynamic_keys = [
+            "getKey()",
+            "helper.get()",
+            "a + b",
+            "helper[0]",
+            "key",
+            "helper[`key`]",
+            "helper[Object.keys(a)[0]]",
+            "helper[this.key]",
+        ];
+        for source in static_keys {
+            assert!(
+                is_alias_key(&key(source)),
+                "{source} must stay a static alias"
+            );
+        }
+        for source in dynamic_keys {
+            assert!(
+                !is_alias_key(&key(source)),
+                "{source} must stay dynamic: the relaxation overshot"
+            );
+        }
+    }
+
+    /// A signature erases names, so a computed property whose key is itself a variable spells
+    /// like a name: `record[helper[key]]` is admitted even though no literal key can be read
+    /// off it. The reader then fails loudly (`unsupported computed property`) instead of
+    /// resolving a guessed key, so the gap costs a solve, not a wrong payload. Recorded here
+    /// so it is not mistaken for a guarantee.
+    #[test]
+    fn a_variable_key_spells_like_a_name() {
+        assert_eq!(
+            signature(&key("helper.key")),
+            signature(&key("helper[key]"))
+        );
+        assert!(is_alias_key(&key("helper[key]")));
+    }
+
+    /// The switch restores the hard-coded check exactly, including the spellings it did not
+    /// accept: the 11-03 check only took a plain `.key`, so `helper['key']` was dynamic.
+    #[test]
+    fn switch_restores_the_hard_coded_check() {
+        assert!(is_alias_key_with(&key("helper.key"), false));
+        for source in [
+            "helper['key']",
+            "helper[`key`]",
+            "helper[0]",
+            "getKey()",
+            "a + b",
+        ] {
+            assert!(
+                !is_alias_key_with(&key(source), false),
+                "{source} was dynamic before the rule table"
+            );
+        }
+        // The whole point of the table: the same alias written the other way is accepted.
+        assert!(is_alias_key_with(&key("helper['key']"), true));
+    }
+
+    /// Only an explicit off value switches the rules off.
+    #[test]
+    fn switch_reads_only_an_explicit_off() {
+        for value in [
+            None,
+            Some(""),
+            Some("on"),
+            Some("ON"),
+            Some("1"),
+            Some("true"),
+        ] {
+            assert!(switch(value), "{value:?} must leave the rules on");
+        }
+        for value in [
+            Some("off"),
+            Some("OFF"),
+            Some(" off "),
+            Some("0"),
+            Some("false"),
+        ] {
+            assert!(!switch(value), "{value:?} must switch the rules off");
+        }
+    }
+
+    /// The switch is read from the environment at first use. A fresh process is the only way to
+    /// prove that without mutating this one.
+    #[test]
+    fn environment_switch_forks_a_fresh_process() {
+        // `helper['key']` separates the two decisions: an alias to the table, dynamic to the
+        // check. Everything else would pass either way and prove nothing.
+        let separator = key("helper['key']");
+        if std::env::var_os("CFSOLVE_ALIAS_RULES_CHILD").is_some() {
+            assert_eq!(std::env::var(SWITCH).as_deref(), Ok("off"));
+            assert!(!enabled(), "{SWITCH}=off must switch the table off");
+            assert!(
+                !is_alias_key(&separator),
+                "the switch must restore the hard-coded check"
+            );
+            assert!(
+                is_admitted("MEMBER(IDENT,IDENT)"),
+                "the table is still loaded: the switch changes the decision, not the data"
+            );
+            return;
+        }
+        assert!(
+            is_alias_key(&separator),
+            "the table must treat `helper['key']` as the alias `helper.key`"
+        );
+        let executable = std::env::current_exe().expect("locate the test executable");
+        let child = std::process::Command::new(executable)
+            .args([
+                "--exact",
+                "alias_rules::tests::environment_switch_forks_a_fresh_process",
+            ])
+            .env(SWITCH, "off")
+            .env("CFSOLVE_ALIAS_RULES_CHILD", "1")
+            .output()
+            .expect("run the test executable");
+        assert!(
+            child.status.success(),
+            "{SWITCH}=off is ignored: {}{}",
+            String::from_utf8_lossy(&child.stdout),
+            String::from_utf8_lossy(&child.stderr)
+        );
+    }
+}
