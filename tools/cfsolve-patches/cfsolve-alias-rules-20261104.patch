index 0893027..6c15f58 100644
--- a/src/challenge/expression.rs
+++ b/src/challenge/expression.rs
@@ -1,13 +1,18 @@
 //! AST helpers for challenge-script expressions: `_cf_chl_opt` reads and writes, padded build
 //! hashes, objects built in a block, and expressions used to construct options and payloads.
 
+use std::cell::RefCell;
+
 use anyhow::{Context, Result, bail, ensure};
 use swc_core::ecma::ast::{
     AssignExpr, AssignTarget, BinExpr, BinaryOp, BlockStmt, Expr, Lit, MemberProp,
     SimpleAssignTarget, Stmt, UnaryOp,
 };
 
+use swc_core::ecma::visit::{Visit, VisitWith};
+
 use crate::js::{self, JsValue, Options, Window, ast};
+use crate::vm::HashMap;
 
 /// Reads the build hash from `"0…0" + <number>.toString(16)`. The zero literal sets the
 /// hexadecimal width. Requires an integer literal that fits without truncation; accepts any
@@ -33,6 +38,98 @@ pub(crate) fn padded_build(sum: &BinExpr) -> Option<String> {
         .then(|| format!("{:0width$x}", number as u64))
 }
 
+thread_local! {
+    /// String-alias entries collected by [`prime_aliases`]: `helper.key -> value`. The
+    /// computed-key fallback consults this instead of re-evaluating member reads, which
+    /// re-walks large subtrees per read and exhausts memory on newer challenge builds.
+    static ALIASES: RefCell<HashMap<(String, String), String>> = RefCell::new(HashMap::default());
+}
+
+/// Collects `helper.key = "value"` assignments across `script` for the computed-key fallback.
+pub(crate) fn prime_aliases(script: &swc_core::ecma::ast::Script) {
+    let mut collector = Collector(HashMap::default());
+    script.visit_with(&mut collector);
+    ALIASES.with(|aliases| *aliases.borrow_mut() = collector.0);
+}
+
+/// Primes the alias table from an already-parsed script (see [`prime_aliases`]).
+pub(crate) fn prime_aliases_program(parsed: &crate::js::ast::ParsedScript) {
+    prime_aliases(&parsed.script);
+}
+
+/// The string a primed alias gives the computed key `expression`, or `None` when the table has
+/// no entry for it.
+///
+/// The shapes admitted here are chosen by [`crate::alias_rules`], so this only has to resolve
+/// the two the collector records. A shape the rules admit but this cannot resolve fails the read
+/// as unsupported instead of resolving a guessed key.
+fn alias_key(expression: &Expr) -> Option<JsValue> {
+    let text = match expression.unwrap_parens() {
+        // `record[helper.key]`: the pair the collector stored for a name assigned on a helper.
+        Expr::Member(member) => {
+            let object = member.obj.as_ident()?;
+            let key = ast::member_str(&member.prop)?;
+            let pair = (object.sym.to_string(), key.to_owned());
+            ALIASES.with(|aliases| aliases.borrow().get(&pair).cloned())?
+        }
+        // `record[alias]`: a name spelled by a bare identifier. The collector only records
+        // helper pairs, so this arm has no entries today; it stays so that a collector which
+        // also records `var alias = "text"` needs no change here.
+        Expr::Ident(name) => {
+            let pair = (String::new(), name.sym.to_string());
+            ALIASES.with(|aliases| aliases.borrow().get(&pair).cloned())?
+        }
+        _ => return None,
+    };
+    Some(JsValue::String(text))
+}
+
+/// Collects string-alias assignments: `helper.key = "value"` and
+/// `var helper = { key: "value", … }`.
+struct Collector(HashMap<(String, String), String>);
+
+impl Visit for Collector {
+    fn visit_assign_expr(&mut self, assignment: &AssignExpr) {
+        if assignment.op == swc_core::ecma::ast::AssignOp::Assign
+            && let swc_core::ecma::ast::AssignTarget::Simple(
+                swc_core::ecma::ast::SimpleAssignTarget::Member(member),
+            ) = &assignment.left
+            && let Expr::Ident(object) = &*member.obj
+            && let MemberProp::Ident(key) = &member.prop
+            && let Some(Expr::Lit(Lit::Str(text))) =
+                Some(&*assignment.right.unwrap_parens())
