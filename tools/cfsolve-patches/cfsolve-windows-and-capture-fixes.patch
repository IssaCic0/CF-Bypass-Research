+#[cfg(windows)]
+fn monotonic_us() -> i64 {
+    // Windows 没有 CLOCK_MONOTONIC。用 QPC —— 它同样是"开机以来"的单调计数，语义最接近。
+    use std::sync::OnceLock;
+    use windows_sys::Win32::System::Performance::{QueryPerformanceCounter, QueryPerformanceFrequency};
+    static FREQ: OnceLock<i64> = OnceLock::new();
+    let freq = *FREQ.get_or_init(|| {
+        let mut f: i64 = 0;
+        // SAFETY: 传入有效指针；QPC 频率在进程生命周期内不变。
+        let ok = unsafe { QueryPerformanceFrequency(&mut f) };
+        assert!(ok != 0 && f > 0, "QueryPerformanceFrequency failed");
+        f
+    });
+    let mut c: i64 = 0;
+    // SAFETY: 同上，写入我们自己的栈变量。
+    let ok = unsafe { QueryPerformanceCounter(&mut c) };
+    assert!(ok != 0, "QueryPerformanceCounter failed");
+    ((c as i128 * 1_000_000) / freq as i128) as i64
+}
