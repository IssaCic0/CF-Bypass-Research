+/// Process-wide override for the RSA modulus, for builds that construct it at runtime.
+///
+/// Newer Cloudflare builds no longer contain a static `BigInt("0x...")` literal, so
+/// [`rsa_modulus`] finds no candidate. A value observed in a real browser can be supplied
+/// through this instead (see `capture-proxy --modulus`).
+static MODULUS_OVERRIDE: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+
+/// Sets the modulus override. Only the first call takes effect.
+pub fn set_modulus_override(hex: String) {
+    let _ = MODULUS_OVERRIDE.set(hex);
+}
+
 /// Finds the `BigInt("0x...")` modulus wide enough to encrypt the seed.
 fn rsa_modulus(root: &BlockStmt) -> Result<BigUint> {
     let moduli = expression::assignments(root)
         .filter_map(|assignment| big_int(&assignment.right))
         .filter_map(|literal| BigUint::parse_bytes(literal.strip_prefix("0x")?.as_bytes(), 16))
         .filter(|modulus| modulus.bits().div_ceil(8) == SEED_LENGTH as u64);
-    candidates::exactly_one(moduli, "RSA modulus")
+    match candidates::exactly_one(moduli, "RSA modulus") {
+        Ok(modulus) => Ok(modulus),
+        Err(error) => match MODULUS_OVERRIDE.get() {
+            Some(hex) => {
+                let digits = hex.trim_start_matches("0x");
+                BigUint::parse_bytes(digits.as_bytes(), 16)
+                    .with_context(|| format!("--modulus is not valid hex: {hex}"))
+            }
+            None => Err(error),
+        },
+    }
 }
 
