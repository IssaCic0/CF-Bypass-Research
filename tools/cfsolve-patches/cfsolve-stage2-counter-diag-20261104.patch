+/// Finds the field the record's creation pass writes its counter into.
+///
+/// Every property write whose key is a register is a candidate, because the name lands in the
+/// register earlier builds kept constant. When none passes, the candidates are what a renamed
+/// field costs: they name the registers that had no recovered name, and the recovered names the
+/// creation pass never writes as a key.
+fn counter_field(
+    creation: &BTreeSet<u32>,
+    listing: &Listing,
+    names: &BTreeMap<u8, String>,
+) -> std::result::Result<String, Failure> {
+    let mut candidates = Vec::new();
+    let mut keyed = BTreeSet::new();
+    let mut found = None;
+    for pc in creation {
+        let Some(instruction) = listing.instructions.get(pc) else {
+            continue;
+        };
+        for effect in instruction.effects() {
+            let Effect::SetProperty { key, .. } = effect else {
+                continue;
+            };
+            let Term::Reg(register) = **key else {
+                candidates.push(Candidate::at(
+                    *pc,
+                    format!("key {key:?}"),
+                    "the property key is not a register, so no recovered name applies",
+                ));
+                continue;
+            };
+            keyed.insert(register);
+            match names.get(&register) {
+                Some(name) => {
+                    if found.is_none() {
+                        found = Some(name.clone());
+                    }
+                }
+                None => candidates.push(Candidate::at(
+                    *pc,
+                    format!("register r{register}"),
+                    "no field name was recovered for this register",
+                )),
+            }
+        }
+    }
+    if let Some(found) = found {
+        return Ok(found);
+    }
+    // The names that were recovered but never reached a property write: the likeliest cause of a
+    // build that moved the counter, and the answer to "what else could it be".
+    for (register, name) in names {
+        if !keyed.contains(register) {
+            candidates.push(Candidate::at(
+                0,
+                format!("register r{register} = {name}"),
+                "a recovered name the creation pass never writes as a property key",
+            ));
+        }
+    }
+    Err(Failure::new(
+        "counter",
+        "a creation-pass write whose key register holds a recovered field name",
+        candidates,
+        "record counter field not found".to_owned(),
+    ))
+}
+
+/// Finds the field a probe's value is written through, or reports the literals it considered.
+fn written_field(
+    assertion: &'static str,
+    expected: &'static str,
+    mismatch: &'static str,
+    literals: &[RecordLiteral],
+    probes: &[Probe],
+    matches: impl Fn(&Probe, &JsValue) -> bool,
+) -> std::result::Result<String, Failure> {
+    let mut candidates = Vec::new();
+    for literal in literals {
+        if !literal.created {
+            candidates.push(Candidate::at(
+                literal.pc,
+                format!("field {}", literal.field),
+                "the literal belongs to the payload, not to a created record",
+            ));
+            continue;
+        }
+        if probes.iter().any(|probe| matches(probe, &literal.value)) {
+            return Ok(literal.field.clone());
+        }
+        candidates.push(Candidate::at(
+            literal.pc,
+            format!("field {}", literal.field),
+            mismatch,
+        ));
+    }
+    Err(Failure::new(
+        assertion,
+        expected,
+        candidates,
+        format!("record {assertion} field not found"),
+    ))
+}
+
+/// Finds a wrapper field holding a value of the wanted shape. Only header names are wrappers:
+/// the payload's own fields are written in the same body.
+fn wrapper_field(
+    assertion: &'static str,
+    expected: &'static str,
+    mismatch: &'static str,
+    wrapper: &[(String, Known<Term>)],
+    header: &BTreeMap<u8, String>,
+    wanted: impl Fn(&Known<Term>) -> bool,
+) -> std::result::Result<String, Failure> {
+    let mut candidates = Vec::new();
+    for (field, value) in wrapper {
+        if !header.values().any(|name| name == field) {
+            candidates.push(Candidate::new(
+                "wrapper",
+                format!("field {field}"),
+                "the field is not a header name, so it is not a wrapper field",
+            ));
+            continue;
+        }
+        if wanted(value) {
+            return Ok(field.clone());
+        }
+        candidates.push(Candidate::new(
+            "wrapper",
+            format!("field {field}"),
+            mismatch,
+        ));
+    }
+    Err(Failure::new(
+        assertion,
+        expected,
+        candidates,
+        format!("record {assertion} field not found"),
+    ))
+}
+
+/// One candidate an assertion rejected, and why.
+#[derive(Debug)]
+struct Candidate {
+    /// Where it was read from: a program counter, or the wrapper body.
+    locator: String,
+    /// What the candidate is: a register, a field name, or a store.
+    subject: String,
+    /// Why the assertion passed it over.
+    rejected: &'static str,
+}
+
+impl Candidate {
+    fn at(pc: u32, subject: String, rejected: &'static str) -> Self {
+        Self {
+            locator: format!("pc {pc}"),
+            subject,
+            rejected,
+        }
+    }
+
+    fn new(locator: &str, subject: String, rejected: &'static str) -> Self {
+        Self {
+            locator: locator.to_owned(),
+            subject,
+            rejected,
+        }
+    }
+}
+
+/// One envelope assertion that found no field, with everything needed to see why.
+#[derive(Debug)]
+pub(super) struct Failure {
+    /// The envelope field this assertion recovers.
+    assertion: &'static str,
+    /// The shape a candidate must have to pass.
+    expected: &'static str,
+    /// Rejected candidates, in program order, up to [`MAX_CANDIDATES`].
+    candidates: Vec<Candidate>,
+    /// Rejected candidates past the ones listed.
+    omitted: usize,
+    /// The message this assertion reported before the report was structured, kept verbatim so
+    /// existing matches on it keep working.
+    detail: String,
+}
+
+impl Failure {
+    fn new(
+        assertion: &'static str,
+        expected: &'static str,
+        mut candidates: Vec<Candidate>,
+        detail: String,
+    ) -> Self {
+        let omitted = candidates.len().saturating_sub(MAX_CANDIDATES);
+        candidates.truncate(MAX_CANDIDATES);
+        Self {
+            assertion,
+            expected,
+            candidates,
+            omitted,
+            detail,
+        }
+    }
+}
+
+impl Display for Failure {
+    fn fmt(&self, f: &mut Formatter<'_>) -> fmt::Result {
+        writeln!(
+            f,
+            "assertion {}: record {} field not found",
+            self.assertion, self.assertion
+        )?;
+        writeln!(f, "  expected: {}", self.expected)?;
+        writeln!(f, "  location: {LOCATION}")?;
+        writeln!(
+            f,
+            "  candidates: {} rejected",
+            self.candidates.len() + self.omitted
+        )?;
+        for candidate in &self.candidates {
+            writeln!(
+                f,
+                "    {} {}: {}",
+                candidate.locator, candidate.subject, candidate.rejected
+            )?;
+        }
+        if self.omitted > 0 {
+            writeln!(f, "    … and {} more", self.omitted)?;
+        }
+        write!(f, "  detail: {}", self.detail)
+    }
+}
+
+/// Every envelope assertion that failed, reported together so one missing field does not hide
+/// the candidates for another.
+#[derive(Debug)]
+pub(super) struct Report(Vec<Failure>);
+
+impl Display for Report {
+    fn fmt(&self, f: &mut Formatter<'_>) -> fmt::Result {
+        write!(
+            f,
+            "{} record-envelope assertion(s) found no field",
+            self.0.len()
+        )?;
+        for (index, failure) in self.0.iter().enumerate() {
+            write!(f, "\n[{}] {failure}", index + 1)?;
+        }
+        Ok(())
+    }
+}
+
+impl std::error::Error for Report {}
