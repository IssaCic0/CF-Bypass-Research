+
+    /// One instruction whose single path carries `effects`.
+    fn instruction(pc: u32, effects: Vec<Effect>) -> Instruction {
+        Instruction {
+            pc,
+            key: 0,
+            opcode: 0,
+            paths: vec![Path {
+                conditions: Vec::new(),
+                effects,
+                exit: Exit::Return,
+            }],
+        }
+    }
+
+    /// `record[r7] = r1` at `pc`: a property write keyed by a register.
+    fn keyed_write(pc: u32, register: u8) -> Instruction {
+        instruction(
+            pc,
+            vec![Effect::SetProperty {
+                object: Box::new(Term::Reg(0)),
+                key: Box::new(Term::Reg(register)),
+                value: Box::new(Term::Reg(1)),
+            }],
+        )
+    }
+
+    /// A failed counter lookup reports its candidates, where they were read from, and the message
+    /// it used to report alone. Before this, the whole diagnostic was that one message.
+    #[test]
+    fn counter_candidates_are_reported_on_failure() {
+        let mut listing = Listing::default();
+        listing.instructions.insert(10, keyed_write(10, 7));
+        let mut names = BTreeMap::new();
+        names.insert(3, "unreached".to_owned());
+        let failure = counter_field(&BTreeSet::from([10]), &listing, &names)
+            .expect_err("r7 has no recovered name");
+        let report = failure.to_string();
+        for expected in [
+            "assertion counter",
+            "expected: a creation-pass write whose key register holds a recovered field name",
+            "iframe.deobfuscated.js",
+            "candidates: 2 rejected",
+            "pc 10 register r7: no field name was recovered for this register",
+            "register r3 = unreached",
+            "detail: record counter field not found",
+        ] {
+            assert!(
+                report.contains(expected),
+                "{expected} missing from:\n{report}"
+            );
+        }
+    }
+
+    /// The first named write stays the answer, so the report does not change which field is read.
+    #[test]
+    fn counter_field_keeps_the_first_named_write() {
+        let mut listing = Listing::default();
+        listing.instructions.insert(10, keyed_write(10, 7));
+        listing.instructions.insert(20, keyed_write(20, 8));
+        let mut names = BTreeMap::new();
+        names.insert(7, "dd".to_owned());
+        names.insert(8, "other".to_owned());
+        assert_eq!(
+            counter_field(&BTreeSet::from([10, 20]), &listing, &names).expect("r7 is named"),
+            "dd"
+        );
+    }
+
+    /// A property write keyed by something other than a register is reported as such, instead of
