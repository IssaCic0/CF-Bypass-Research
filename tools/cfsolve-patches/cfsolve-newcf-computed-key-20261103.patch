+/// Whether a computed member key is a static member read (`obj.key`), whose value a later
+/// inlining pass can turn into a literal. Matches only identifier objects with static keys.
+#[must_use]
+fn is_static_member_key(property: &MemberProp) -> bool {
+    match property {
+        MemberProp::Computed(computed) => match &*computed.expr {
+            Expr::Member(member) => {
+                member.obj.as_ident().is_some()
+                    && matches!(&member.prop, MemberProp::Ident(_))
+            }
+            _ => false,
+        },
+        _ => false,
+    }
+}
